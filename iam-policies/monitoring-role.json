{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogIngestionOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:eu-west-1:${ACCOUNT_ID}:log-group:/altpay/app/*"
    },
    {
      "Sid": "CloudWatchPutCustomMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AltPay/App"
        }
      }
    }
  ]
}